PORT=3000
NODE_ENV=production
JWT_SECRET=change-me
CORS_ORIGIN=*
DB_DIR=/var/data
REQUIRE_PERSISTENT_DB=true
RENDER_DISK_MOUNT_PATH=/var/data
BASE_URL=https://maximan-jump-tour.onrender.com

# Email configuration (optional - for invitation emails)
# For Render/Production: Use SendGrid, Mailgun, or similar SMTP service
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@maximan-jump-tour.local

# For Development: Uses Ethereal Email (free test service) by default if not configured
